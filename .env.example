# Local Supabase CLI stack. Run `npm run supabase:start` and
# `npx supabase status -o env`, then paste the local publishable/secret values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Workers: set NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, and SUPABASE_SERVICE_ROLE_KEY as
# Worker secrets from a network-reachable self-hosted Supabase instance.
# Keep local values in .env.local or .dev.vars.

# Browser analytics. Leave blank to run locally without third-party scripts.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_LEAD_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_DASHBOARD_START_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_CALCULATOR_LEAD_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-local-secret-key
META_CAPI_ACCESS_TOKEN=
META_CAPI_GRAPH_API_VERSION=v24.0
META_CAPI_TEST_EVENT_CODE=
