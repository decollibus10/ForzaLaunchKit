# Production-only public build values for Cloudflare/OpenNext checks and deploys.
# Copy to `.env.production.local` and replace placeholders with the real
# self-hosted HTTPS Supabase gateway values before `npm run check:deploy`.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.forza-funding.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key
NEXT_PUBLIC_SITE_URL=https://forza-funding.com

# Optional browser analytics for live traffic. Leave blank until launch.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_LEAD_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_DASHBOARD_START_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_CALCULATOR_LEAD_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
