{
  "name": "forza-broker-marketplace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run worker:secrets:check && node scripts/run-with-worker-vars.mjs -- npm run deploy:raw",
    "deploy:raw": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "node scripts/run-with-worker-vars.mjs -- npm run upload:raw",
    "upload:raw": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "env:check": "node scripts/check-env.mjs",
    "env:check:strict": "node scripts/check-env.mjs --strict",
    "env:check:deploy": "node scripts/run-with-worker-vars.mjs -- npm run env:check:strict",
    "smoke:local": "node scripts/smoke.mjs --base=http://localhost:8787 --write",
    "smoke:worker": "node scripts/smoke.mjs --base=https://forza-clearmatch.c10decollibus.workers.dev --read-only",
    "smoke:prod": "node scripts/smoke.mjs --base=https://forza-funding.com --read-only",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "check:deploy": "node scripts/run-with-worker-vars.mjs -- npm run check:deploy:raw",
    "check:deploy:raw": "npm run check && npm run cloudflare:build && npx wrangler deploy --dry-run && npm run bundle:env:check",
    "bundle:env:check": "node scripts/check-bundle-env.mjs",
    "worker:secrets:check": "node scripts/check-worker-secrets.mjs",
    "worker:secrets:check:paid": "node scripts/check-worker-secrets.mjs --paid",
    "supabase:start": "npx supabase start -x vector",
    "supabase:status": "npx supabase status",
    "supabase:env": "npx supabase status -o env",
    "supabase:reset": "npx supabase db reset",
    "supabase:stop": "npx supabase stop",
    "supabase:migrations": "npx supabase migration list --local"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.5",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.105.1",
    "lucide-react": "1.14.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "25.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.4",
    "typescript": "5.9.3",
    "wrangler": "^4.87.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
