{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forza-clearmatch",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-03",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "forza-funding.com",
      "custom_domain": true
    },
    {
      "pattern": "www.forza-funding.com",
      "custom_domain": true
    }
  ]
}
